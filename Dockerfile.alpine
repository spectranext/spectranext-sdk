FROM alpine:3.23.4 AS toolchain

# Build deps (install.sh adds more at runtime; pre-install for layer caching)
RUN apk update && apk add --no-cache \
    bash sudo cmake git build-base python3 py3-pip py3-setuptools gmp-dev \
    libxml2 libxml2-dev m4 perl perl-utils perl-dev bison flex ragel \
    dos2unix re2c jpeg-dev zlib-dev curl && \
    cpan install Modern::Perl YAML::Tiny CPU::Z80::Assembler

WORKDIR /sdk
# Keep z88dk and Python dependencies in a cacheable layer. Library sources and
# other SDK files are copied only in the final stage, so editing them does not
# reinstall the toolchain.
COPY install.sh requirements.txt ./
RUN ./install.sh

FROM toolchain

WORKDIR /sdk
COPY . /sdk
